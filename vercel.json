{
  "buildCommand": "python3 build.py",
  "rewrites": [
    {
      "source": "/share/skin/:slug",
      "destination": "/share/skin/:slug/index.html"
    },
    {
      "source": "/share/addon/:slug",
      "destination": "/share/addon/:slug/index.html"
    },
    {
      "source": "/share/game/:slug",
      "destination": "/share/game/:slug/index.html"
    },
    {
      "source": "/share/tools/:slug",
      "destination": "/share/tools/:slug/index.html"
    },
    {
      "source": "/skin",
      "destination": "/index.html"
    },
    {
      "source": "/skin/share",
      "destination": "/index.html"
    },
    {
      "source": "/addon",
      "destination": "/index.html"
    },
    {
      "source": "/addon/share",
      "destination": "/index.html"
    },
    {
      "source": "/game",
      "destination": "/index.html"
    },
    {
      "source": "/game/share",
      "destination": "/index.html"
    },
    {
      "source": "/tools",
      "destination": "/index.html"
    },
    {
      "source": "/tools/share",
      "destination": "/index.html"
    },
    {
      "source": "/info",
      "destination": "/index.html"
    }
  ]
}
